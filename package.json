{
  "name": "lambda-web-functions-hello",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "dev": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=cjs --outfile=dist/index.js && printf '{\"type\":\"commonjs\"}' > dist/package.json && AUTH_ENDPOINT_IAM=iam AUTH_ENDPOINT_JWT=public COGNITO_USER_POOL_ID=us-west-2_000000000 COGNITO_CLIENT_ID=local node dist/index.js",
    "build": "bash scripts/build.sh"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.2.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "supertest": "^7.3.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
