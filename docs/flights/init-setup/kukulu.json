{
  "verify": [
    { "cmd": "npm run typecheck", "from": "P1-01" },
    { "cmd": "npm run lint", "from": "P1-01" },
    { "cmd": "npm test", "from": "P1-01" },
    { "cmd": "npm run build", "from": "P2-03" }
  ],
  "extraVerify": {
    "infra/": [{ "cmd": "cfn-lint infra/*.yaml", "from": "P2-01" }]
  },
  "build": ["npm run build"],
  "baseBranch": "main",
  "branchPrefix": "build/",
  "maxRounds": 3,
  "maxRoundsHard": 6,
  "flight": "init-setup",
  "mutation": {
    "targeted": {
      "vitest": { "cmd": "npx vitest run {filter}" }
    }
  },
  "constraints": [
    {
      "id": "process-env-only-in-config",
      "description": "SPEC section 3 principle 1: process.env appears only in src/config.ts. loadConfig takes an env object so tests never touch process.env; scripts/smoke-iam.ts takes its inputs from argv.",
      "paths": ["src/", "test/", "scripts/", "vitest.config.ts", "eslint.config.js"],
      "exclude": ["src/config.ts"],
      "pattern": "\\bprocess\\s*(\\.\\s*env\\b|\\[\\s*['\"]env['\"]\\s*\\])|\\{\\s*env\\b[^}]*\\}\\s*=\\s*process\\b",
      "shouldMatch": [
        "const region = process.env.AWS_REGION;",
        "const { STREAM_TICKS } = process.env;",
        "spawn(cmd, args, { env: { ...process.env, FOO: '1' } });",
        "const e = process['env'];",
        "const { env } = process;"
      ],
      "shouldNotMatch": [
        "const config = loadConfig({ AUTH_ENDPOINT_IAM: 'iam' });",
        "const env = options.env;",
        "spawn(process.execPath, [entry], { env: childEnv });"
      ]
    },
    {
      "id": "endpoint-header-only-in-auth",
      "description": "SPEC section 3 principle 2: lambda-web-endpoint-name is read only in src/auth/index.ts.",
      "paths": ["src/"],
      "exclude": ["src/auth/index.ts"],
      "pattern": "lambda-web-endpoint-name",
      "flags": "i",
      "shouldMatch": [
        "const name = req.get('lambda-web-endpoint-name');",
        "const name = req.headers['Lambda-Web-Endpoint-Name'];",
        "const ENDPOINT_HEADER = \"lambda-web-endpoint-name\";"
      ],
      "shouldNotMatch": [
        "const id = req.get('lambda-web-request-id');",
        "const auth = res.locals.auth as AuthContext;"
      ]
    },
    {
      "id": "no-auth-bypass-mode",
      "description": "SPEC section 3 principle 2: there is no auth disabled / none / off / skip mode anywhere in src/.",
      "paths": ["src/"],
      "pattern": "\\b(skipAuth|disableAuth|authDisabled|noAuth|AUTH_DISABLED|AUTH_MODE|AUTH_ENABLED)\\b|['\"](none|off|skip|disabled)['\"]",
      "shouldMatch": [
        "if (config.skipAuth) return next();",
        "authMode: 'none',",
        "case \"off\":",
        "const disabled = env.AUTH_DISABLED === 'true';",
        "type AuthMode = 'iam' | 'jwt' | 'disabled';"
      ],
      "shouldNotMatch": [
        "authMode: 'iam',",
        "res.setHeader('Cache-Control', 'no-cache');",
        "export type AuthMode = 'iam' | 'jwt';"
      ]
    },
    {
      "id": "jwt-lib-only-in-adapter",
      "description": "SPEC section 3 principle 3: only src/auth/jwt-verifier.ts imports (or mocks) aws-jwt-verify.",
      "paths": ["src/", "test/", "scripts/"],
      "exclude": ["src/auth/jwt-verifier.ts"],
      "pattern": "['\"]aws-jwt-verify(/[^'\"]*)?['\"]",
      "shouldMatch": [
        "import { CognitoJwtVerifier } from 'aws-jwt-verify';",
        "vi.mock(\"aws-jwt-verify\");",
        "import { JwtExpiredError } from 'aws-jwt-verify/error';"
      ],
      "shouldNotMatch": [
        "import { createJwtVerifier } from '../src/auth/jwt-verifier.ts';",
        "// the adapter wraps aws-jwt-verify behind JwtVerifier"
      ]
    },
    {
      "id": "no-module-level-mutable-state",
      "description": "SPEC section 3 principle 4: the only module-level mutable state in src/ is in src/env-info.ts. Catches top-level let/var and top-level Map/Set/Array instances; top-level object/array literals mutated later are checked by the reviewer by reading.",
      "paths": ["src/"],
      "exclude": ["src/env-info.ts"],
      "pattern": "^(export\\s+)?(let|var)\\s|^(export\\s+)?const\\s+\\w+(\\s*:[^=]+)?\\s*=\\s*new\\s+(Map|Set|WeakMap|WeakSet|Array)\\b",
      "shouldMatch": [
        "let requestCount = 0;",
        "export let current: string | null = null;",
        "var cache = {};",
        "const seen = new Map<string, number>();",
        "export const pending: Set<string> = new Set();"
      ],
      "shouldNotMatch": [
        "  let n = 0;",
        "const app = express();",
        "export const envId = randomUUID();",
        "    const timers = new Set();"
      ]
    },
    {
      "id": "no-forwarded-host",
      "description": "SPEC section 1: X-Forwarded-Host is forwarded unvalidated, so src/ never reads it and never enables Express trust proxy.",
      "paths": ["src/"],
      "pattern": "x-forwarded-host|trust proxy",
      "flags": "i",
      "shouldMatch": [
        "const host = req.get('X-Forwarded-Host');",
        "app.set('trust proxy', true);"
      ],
      "shouldNotMatch": [
        "const id = req.get('lambda-web-request-id');",
        "app.disable('x-powered-by');"
      ]
    },
    {
      "id": "no-import-meta-in-src",
      "description": "SPEC section 4: the deployed bundle is CommonJS; esbuild empties import.meta in CJS output, so src/ never uses it.",
      "paths": ["src/"],
      "pattern": "\\bimport\\.meta\\b",
      "shouldMatch": [
        "if (import.meta.url === pathToFileURL(process.argv[1]).href) {",
        "const here = dirname(fileURLToPath(import.meta.url));"
      ],
      "shouldNotMatch": [
        "import { createApp } from './app.ts';",
        "import type { Config } from './config.ts';"
      ]
    },
    {
      "id": "stream-tunables-only-in-config",
      "description": "SPEC section 3 principle 8 and section 5: stream.ticks (5) and stream.intervalMs (500) are ASSUMPTION defaults that live only in src/config.ts.",
      "paths": ["src/", "scripts/", "infra/"],
      "exclude": ["src/config.ts"],
      "pattern": "\\b(ticks|intervalMs|STREAM_TICKS|STREAM_INTERVAL_MS)['\"]?\\s*(\\?\\?|\\|\\||=|:)\\s*['\"]?[0-9]",
      "shouldMatch": [
        "const ticks = 5;",
        "intervalMs: 500,",
        "const n = config.stream.ticks ?? 5;",
        "const ms = opts.intervalMs || 500;",
        "STREAM_INTERVAL_MS: '500'",
        "STREAM_TICKS=5 node dist/index.js",
        "'intervalMs': 500,"
      ],
      "shouldNotMatch": [
        "const ticks = config.stream.ticks;",
        "for (let n = 1; n <= config.stream.ticks; n++) {",
        "const timer = setInterval(send, config.stream.intervalMs);",
        "res.write(`data: ${JSON.stringify({ tick: n })}\\n\\n`);"
      ]
    },
    {
      "id": "listen-default-only-in-config",
      "description": "SPEC section 3 principle 8 and section 5: the local listen default 127.0.0.1:3000 lives only in src/config.ts.",
      "paths": ["src/", "scripts/"],
      "exclude": ["src/config.ts"],
      "pattern": "127\\.0\\.0\\.1|\\b3000\\b",
      "shouldMatch": [
        "const endpoint = env.AWS_LAMBDA_HTTP_ENDPOINT ?? '127.0.0.1:3000';",
        "const host = '127.0.0.1';",
        "port: 3000,",
        "const port = Number(raw) || 3000;"
      ],
      "shouldNotMatch": [
        "server.listen(config.listen.port, config.listen.host, onListening);",
        "res.status(500).json({ error: 'internal' });",
        "const graceMs = 30000;"
      ]
    },
    {
      "id": "infra-no-account-id",
      "description": "SPEC section 3 principle 5: no 12-digit account IDs under infra/; use AWS::AccountId.",
      "paths": ["infra/"],
      "pattern": "[0-9]{12}",
      "shouldMatch": [
        "RoleArn: arn:aws:iam::123456789012:role/x",
        "Principal: { AWS: '210987654321' }"
      ],
      "shouldNotMatch": [
        "!Sub arn:aws:iam::${AWS::AccountId}:role/x",
        "Default: 100"
      ]
    },
    {
      "id": "infra-no-region-literal",
      "description": "SPEC section 3 principle 5: no Region literals under infra/; use AWS::Region.",
      "paths": ["infra/"],
      "pattern": "(us|eu|ap|sa|ca|me|af|il|mx)-[a-z]+-[0-9]",
      "shouldMatch": [
        "Region: us-west-2",
        "!Sub arn:aws:s3:::bucket-eu-central-1/*",
        "Value: ap-southeast-2"
      ],
      "shouldNotMatch": [
        "!Sub \"${AWS::Region}\"",
        "Runtime: nodejs24.x",
        "EndpointType: HomeRegion"
      ]
    },
    {
      "id": "infra-tunables-are-parameters",
      "description": "SPEC section 3 principle 8 and section 5: TimeoutSeconds, MaxConcurrencyPerEnvironment, MaxEnvironments, RateLimit and ApplicationLogLevel get their values only from infra/app.yaml Parameters (Default:), never a literal in Resources or in a script.",
      "paths": ["infra/", "scripts/"],
      "pattern": "\\b(TimeoutSeconds|MaxConcurrencyPerEnvironment|MaxEnvironments|RateLimit|ApplicationLogLevel)['\"]?\\s*[:=]\\s*['\"]?[0-9A-Z]|ParameterKey=(TimeoutSeconds|MaxConcurrencyPerEnvironment|MaxEnvironments|RateLimit|ApplicationLogLevel),ParameterValue=['\"]?[0-9A-Z]",
      "shouldMatch": [
        "        RateLimit: 100",
        "ScalingConfig: { MaxEnvironments: 2 }",
        "            ApplicationLogLevel: INFO",
        "        TimeoutSeconds: '30'",
        "  --parameter-overrides MaxEnvironments=2",
        "ParameterKey=RateLimit,ParameterValue=100"
      ],
      "shouldNotMatch": [
        "        RateLimit: !Ref RateLimit",
        "  MaxEnvironments:",
        "        MaxConcurrencyPerEnvironment: !Ref MaxConcurrencyPerEnvironment",
        "    Default: 2",
        "  --parameter-overrides \"CodeBucket=$BUCKET\" \"CodeKey=$KEY\""
      ]
    },
    {
      "id": "tests-and-build-never-call-aws",
      "description": "SPEC section 2 non-goal and section 3 principle 6: no file under test/ and no section 7 command (scripts/build.sh) invokes the aws CLI or creates an AWS SDK client.",
      "paths": ["test/", "scripts/build.sh"],
      "pattern": "@aws-sdk/|\\bnew\\s+[A-Z]\\w*Client\\s*\\(|\\baws\\s+(s3|s3api|cloudformation|cognito-idp|lambda|sts|iam|configure)\\b|['\"]aws['\"]",
      "shouldMatch": [
        "import { S3Client } from '@aws-sdk/client-s3';",
        "const client = new CloudFormationClient({});",
        "execSync('aws cloudformation describe-stacks');",
        "spawnSync('aws', ['sts', 'get-caller-identity']);",
        "aws s3 cp dist/app.zip \"s3://$BUCKET/$KEY\""
      ],
      "shouldNotMatch": [
        "import { createJwtVerifier } from '../src/auth/jwt-verifier.ts';",
        "const text = readFileSync('infra/app.yaml', 'utf8');",
        "expect(entries).toEqual(['index.js']);",
        "expect(resource.Type).toBe('AWS::Lambda::WebFunction');"
      ]
    }
  ]
}
