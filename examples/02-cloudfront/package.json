{
  "name": "lambda-web-functions-cloudfront",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --exclude test/bundle.test.ts",
    "test:bundle": "npm run build && vitest run test/bundle.test.ts",
    "dev": "esbuild src/server.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/index.mjs --banner:js='import { createRequire } from \"node:module\"; const require = createRequire(import.meta.url);' && AUTH_MODE=jwt COGNITO_USER_POOL_ID=us-west-2_000000000 COGNITO_CLIENT_ID=local node dist/index.mjs",
    "build": "sam build && node scripts/finalize-esm-build.ts",
    "deploy": "npm run build && sam deploy",
    "teardown": "sam delete --no-prompts",
    "get-jwt": "bash scripts/get-jwt.sh",
    "smoke:jwt": "bash scripts/smoke-jwt.sh",
    "smoke:iam": "bash -c 'source scripts/env.sh && node scripts/smoke-iam.ts \"$(stack_output \"$STACK_NAME\" IamEndpointUrl)\" \"$AWS_REGION\"'"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.2.1",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/credential-provider-node": "^3.972.94",
    "@eslint/js": "^10.0.1",
    "@smithy/signature-v4": "^5.7.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
